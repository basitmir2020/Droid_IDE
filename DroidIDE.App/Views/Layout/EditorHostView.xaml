<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DroidIDE.App.ViewModels"
             xmlns:editor="clr-namespace:DroidIDE.App.Views.Editor"
             xmlns:layout="clr-namespace:DroidIDE.App.Views.Layout"
             x:Class="DroidIDE.App.Views.Layout.EditorHostView"
             x:DataType="vm:EditorViewModel"
             BackgroundColor="#1E1E1E">

    <Grid>
        <!-- Monaco editor when a tab is active -->
        <editor:MonacoEditorView x:Name="MonacoEditor"
                                  IsVisible="{Binding ActiveTab, Converter={StaticResource IsNotNullConverter}}"/>

        <!-- Empty state when no tab is open (Welcome View) -->
        <layout:WelcomeView VerticalOptions="Fill"
                            HorizontalOptions="Fill"
                            IsVisible="{Binding Editor.ActiveTab, Converter={StaticResource IsNullConverter}}"
                            BindingContext="{Binding Source={RelativeSource AncestorType={x:Type vm:MainShellViewModel}}}"/>
    </Grid>
</ContentView>