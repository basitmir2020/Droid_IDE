<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DroidIDE.App.ViewModels"
             x:Class="DroidIDE.App.Views.Layout.WelcomeView"
             x:DataType="vm:MainShellViewModel"
             BackgroundColor="#1E1E1E">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center"
                              HorizontalOptions="Center"
                              Padding="40"
                              Spacing="24"
                              MaximumWidthRequest="520">

            <!-- Logo / App name -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🤖"
                       FontSize="48"
                       HorizontalOptions="Center"/>

                <Label Text="Welcome to DroidIDE"
                       TextColor="#D4D4D4"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>

                <Label Text="A powerful Android IDE built with .NET MAUI"
                       TextColor="#888888"
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Quick actions -->
            <Border BackgroundColor="#252526" Stroke="#3C3C3C"
                   StrokeShape="RoundRectangle 8" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="GET STARTED"
                           TextColor="#0078D4"
                           FontSize="11"
                           FontAttributes="Bold"/>

                    <!-- Open Folder -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenFolderCommand}"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="📂" FontSize="20"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Open Folder" TextColor="#D4D4D4"
                                   FontSize="14"/>
                            <Label Text="Open an existing project or folder"
                                   TextColor="#888888" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#3C3C3C"/>

                    <!-- Clone Repo -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloneRepoCommand}"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="⎇" FontSize="20"
                               TextColor="#0078D4" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Clone Repository" TextColor="#D4D4D4"
                                   FontSize="14"/>
                            <Label Text="Clone a Git repository from a URL"
                                   TextColor="#888888" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#3C3C3C"/>

                    <!-- New Project -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NewProjectCommand}"/>
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="➕" FontSize="20"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="New Project" TextColor="#D4D4D4"
                                   FontSize="14"/>
                            <Label Text="Create a new .NET project from a template"
                                   TextColor="#888888" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Keyboard shortcuts hint -->
            <Border BackgroundColor="#252526" Stroke="#3C3C3C"
                   StrokeShape="RoundRectangle 8" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="KEYBOARD SHORTCUTS"
                           TextColor="#0078D4"
                           FontSize="11"
                           FontAttributes="Bold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="Command Palette"
                               TextColor="#D4D4D4" FontSize="12"/>
                        <Label Grid.Column="1" Text="Ctrl+Shift+P"
                               TextColor="#888888" FontSize="11"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="Save File"
                               TextColor="#D4D4D4" FontSize="12"/>
                        <Label Grid.Column="1" Text="Ctrl+S"
                               TextColor="#888888" FontSize="11"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="Find in Files"
                               TextColor="#D4D4D4" FontSize="12"/>
                        <Label Grid.Column="1" Text="Ctrl+Shift+F"
                               TextColor="#888888" FontSize="11"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Text="Build Project"
                               TextColor="#D4D4D4" FontSize="12"/>
                        <Label Grid.Column="1" Text="Ctrl+B"
                               TextColor="#888888" FontSize="11"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Don't show again -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <CheckBox x:Name="DontShowAgainCheckbox"
                          Color="#0078D4"/>
                <Label Text="Don't show this on startup"
                       TextColor="#888888"
                       FontSize="12"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDontShowToggle"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
