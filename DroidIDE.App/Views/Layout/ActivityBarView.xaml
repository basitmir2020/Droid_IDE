<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DroidIDE.App.ViewModels"
             x:Class="DroidIDE.App.Views.Layout.ActivityBarView"
             x:DataType="vm:MainShellViewModel"
             BackgroundColor="#333333">

    <VerticalStackLayout
        Spacing="4"
        Padding="4,12"
        HorizontalOptions="Center">

        <!-- Explorer -->
        <ImageButton Source="explorer.svg"
                     WidthRequest="28"
                     HeightRequest="28"
                     Padding="4"
                     BackgroundColor="Transparent"
                     Command="{Binding ShowPanelCommand}"
                     CommandParameter="Explorer"
                     ToolTipProperties.Text="Explorer"/>

        <!-- Search -->
        <ImageButton Source="search.svg"
                     WidthRequest="28"
                     HeightRequest="28"
                     Padding="4"
                     BackgroundColor="Transparent"
                     Command="{Binding ShowPanelCommand}"
                     CommandParameter="Search"
                     ToolTipProperties.Text="Search"/>

        <!-- Git -->
        <ImageButton Source="git.svg"
                     WidthRequest="28"
                     HeightRequest="28"
                     Padding="4"
                     BackgroundColor="Transparent"
                     Command="{Binding ShowPanelCommand}"
                     CommandParameter="Git"
                     ToolTipProperties.Text="Source Control"/>

        <!-- Debug -->
        <ImageButton Source="debug.svg"
                     WidthRequest="28"
                     HeightRequest="28"
                     Padding="4"
                     BackgroundColor="Transparent"
                     Command="{Binding ShowPanelCommand}"
                     CommandParameter="Debug"
                     ToolTipProperties.Text="Run and Debug"/>

    </VerticalStackLayout>
</ContentView>