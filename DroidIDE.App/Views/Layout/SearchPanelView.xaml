<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DroidIDE.App.ViewModels"
             xmlns:svc="clr-namespace:DroidIDE.App.Services"
             x:Class="DroidIDE.App.Views.Layout.SearchPanelView"
             x:DataType="vm:SearchViewModel"
             BackgroundColor="#252526">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#252526" Padding="12,0">
            <Label Text="SEARCH"
                   TextColor="#BBBBBB"
                   FontSize="11"
                   FontAttributes="Bold"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Search inputs -->
        <VerticalStackLayout Grid.Row="1" Padding="8,4" Spacing="6">

            <!-- Search query -->
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <Entry Grid.Column="0"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       Placeholder="Search..."
                       PlaceholderColor="#888888"
                       TextColor="#D4D4D4"
                       BackgroundColor="#3C3C3C"
                       FontSize="13"
                       ReturnCommand="{Binding SearchCommand}"/>

                <!-- Case sensitivity toggle -->
                <Border Grid.Column="1"
                       Padding="4"
                       StrokeShape="RoundRectangle 4"
                       BackgroundColor="#3C3C3C"
                       Stroke="#3C3C3C"
                       x:Name="CaseToggle">
                    <Label Text="Aa"
                           TextColor="#D4D4D4"
                           FontSize="12"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCaseToggleTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
            </Grid>

            <!-- File filter -->
            <Entry Text="{Binding FileFilter, Mode=TwoWay}"
                   Placeholder="Files to include (e.g. cs,json)"
                   PlaceholderColor="#666666"
                   TextColor="#D4D4D4"
                   BackgroundColor="#3C3C3C"
                   FontSize="11"/>
        </VerticalStackLayout>

        <!-- Results -->
        <CollectionView Grid.Row="2"
                         ItemsSource="{Binding ResultGroups}"
                         Margin="0,4,0,0">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultGroup">
                    <VerticalStackLayout>
                        <!-- File header -->
                        <Grid Padding="8,6" BackgroundColor="#2D2D2D">
                            <Label TextColor="#D4D4D4" FontSize="12" FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding FileName}"/>
                                        <Span Text=" "/>
                                        <Span Text="{Binding MatchCount, StringFormat='({0})'}"
                                              TextColor="#888888"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>

                        <!-- Matches in file -->
                        <CollectionView ItemsSource="{Binding Results}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="svc:SearchResult">
                                        <Grid Padding="20,4,8,4" ColumnSpacing="8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=OpenResultCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Label Grid.Column="0"
                                                   Text="{Binding LineNumber}"
                                                   TextColor="#858585"
                                                   FontSize="11"
                                                   HorizontalTextAlignment="End"/>

                                            <Label Grid.Column="1"
                                                   Text="{Binding LineContent}"
                                                   TextColor="#D4D4D4"
                                                   FontSize="11"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"/>
                                        </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                    <Label Text="No results"
                           TextColor="#888888"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Status bar -->
        <Label Grid.Row="3"
               Text="{Binding StatusText}"
               TextColor="#858585"
               FontSize="11"
               Padding="8,0"
               VerticalOptions="Center"/>
    </Grid>
</ContentView>
