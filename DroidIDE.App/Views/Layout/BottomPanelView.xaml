<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DroidIDE.App.Views.Layout.BottomPanelView" BackgroundColor="#1E1E1E">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <HorizontalStackLayout
            Grid.Row="0"
            BackgroundColor="#252526"
            Padding="10,0">

            <Label Text="TERMINAL"
                   TextColor="#FFFFFF"
                   Margin="0,0,20,0"/>

            <Label Text="OUTPUT"
                   TextColor="#AAAAAA"
                   Margin="0,0,20,0"/>

            <Label Text="PROBLEMS"
                   TextColor="#AAAAAA"/>

        </HorizontalStackLayout>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <Label Text="Terminal Output Here..."
                   TextColor="#CCCCCC"
                   Padding="10"/>
        </ScrollView>

    </Grid>
</ContentPage>