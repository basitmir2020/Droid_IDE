<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DroidIDE.App"
             xmlns:converters="clr-namespace:DroidIDE.App.Converters"
             xmlns:themes="clr-namespace:DroidIDE.App.Resources.Themes"
             x:Class="DroidIDE.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <themes:DarkTheme />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:BoolToIconConverter x:Key="BoolToIconConverter"/>
            <converters:BoolToTabColorConverter x:Key="BoolToTabColorConverter"/>
            <converters:BoolToTabTextColorConverter x:Key="BoolToTabTextColorConverter"/>
            <converters:BoolToModifiedDotConverter x:Key="BoolToModifiedDotConverter"/>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <converters:IsNullConverter x:Key="IsNullConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
